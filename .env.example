# ─────────────────────────────────────────────────────────────
# Copia este archivo como .env.local (desarrollo) y rellena los valores.
# En Vercel: Project → Settings → Environment Variables.
# NINGUNA de estas variables debe empezar por NEXT_PUBLIC_ (son secretas).
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave secreta del servidor ("sb_secret_…"). En proyectos antiguos: la "service_role" key.
# (También se acepta con el nombre SUPABASE_SERVICE_ROLE_KEY.)
SUPABASE_SECRET_KEY=

# Resend → API Keys (permiso "Sending access" es suficiente)
RESEND_API_KEY=

# Remitente. Debe pertenecer a un dominio verificado en Resend,
# p. ej.: Invitación Kevyn <rsvp@tudominio.com>
# Solo para pruebas sin dominio: onboarding@resend.dev (solo envía al email de tu cuenta Resend).
EMAIL_FROM=

# Dirección(es) que reciben cada confirmación. Varias separadas por comas.
RSVP_NOTIFICATION_EMAIL=

# Solo desarrollo: guarda las confirmaciones en memoria para probar sin Supabase.
# Se ignora siempre en producción.
# RSVP_STORE=memory
